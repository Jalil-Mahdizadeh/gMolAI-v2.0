# Generated datasets, manifests, caches, checkpoints, and evaluation artifacts.
# The compact external-review records and exact promoted model already tracked
# under runs/ are deliberate exceptions; these rules keep future bulk output out.
work/
runs/
gMolAI-retrain/

# Slurm output and container images.
slurm-outs/
slurm-*.out
*.sif
*.log

# Large generated ML/data artifacts (defense in depth).
*.pt
*.pth
*.ckpt
*.feather
*.arrow
*.parquet

# Python/tool caches.
__pycache__/
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/
*.py[cod]

# Inference outputs are local products. The exact packaged model pair is an
# intentional exception to the general checkpoint rule above.
inference/output/*
!inference/output/.gitkeep
!inference/model/representation-best.pt
!inference/model/representation-calibrator.pt
