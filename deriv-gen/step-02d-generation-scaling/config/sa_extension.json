    "substantially_harder_delta_min": 1.0,
    "categories": [
      "one_cut_mmp_derivative",
      "scaffold_preserving_non_mmp_analogue",
      "scaffold_changing_analogue",
      "acyclic_non_mmp_analogue"
    ],
    "report_pair_weighted_and_seed_macro_statistics": true,
    "bootstrap_unit": "seed",
    "bootstrap_resamples": 2000,
    "bootstrap_seed": 20260818
  },
  "plots": {
    "sa_histogram_bins": 90,
    "joint_sa_histogram_bins": 90,
    "joint_sa_range": [1.0, 10.0],
    "quality_plot_show_validity_policy_gap_basis_points": true
  },
  "execution": {
    "workers": 64,
    "chunksize": 256,
