 "rascal_benchmarking_set_250513.csv", "size": 542692146, "checksum": "md5:aeaca3651c94a2ee8399483de716851a", "links": {"self": "https://zenodo.org/api/records/18682051/files/rascal_benchmarking_set_250513.csv/content"}}, {"id": "db384b53-801b-49ba-adf4-66fdc88d8052", "key": "compounds_ms2structures.csv", "size": 7947052, "checksum": "md5:fdd8322e44e4f17371702b7245a89e8d", "links": {"self": "https://zenodo.org/api/records/18682051/files/compounds_ms2structures.csv/content"}}, {"id": "fd2b9889-7cf6-459e-a609-12e21eb874bf", "key": "25_subclasses_chemical_subset.csv", "size": 14068128, "checksum": "md5:53b44ac90703e356f56a421bc3a305e3", "links": {"self": "https://zenodo.org/api/records/18682051/files/25_subclasses_chemical_subset.csv/content"}}, {"id": "e158b60c-db22-4987-8ceb-1d56994d1568", "key": "biostructures_with_classyfire_results.csv", "size": 119659831, "checksum": "md5:516c37032d9d34d92afc6ce2f5eafede", "links": {"self": "https://zenodo.org/api/records/18682051/files/biostructures_with_classyfire_results.csv/content"}}], "swh": {}, "owners": [{"id": "61818"}], "status": "published", "stats": {"downloads": 194, "unique_downloads": 170, "views": 194, "unique_views": 171, "version_downloads": 194, "version_unique_downloads": 170, "version_unique_views": 171, "version_views": 194}, "state": "done", "submitted": true}